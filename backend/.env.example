# Supabase Connect > Session pooler. Replace placeholders and encode URL passwords.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Supabase Auth login for existing users linked through students.auth_user_id.
# Set the project URL and publishable (or legacy anon) key.
# Leave both blank only when using Flask-created accounts exclusively.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional server-only admin key for live integration tests. Never expose it.
SUPABASE_SECRET_KEY=
# Use a persistent private random value for stable login sessions.
FLASK_SECRET_KEY=
COOKIE_SECURE=false
# Password recovery: use a real email sender. No emails are sent without these.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
# Linked Supabase accounts also require SUPABASE_SECRET_KEY for password updates.
